{
  "name": "oberfeld/hilfmal",
  "description": "Pikettdienst für Gemeinschaftsräume",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "sabre/vobject": "^4.5",
    "symfony/yaml": "^7.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Hilfmal\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hilfmal\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
